#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_DB="$SCRIPT_DIR/data/tracker.db"

source "$SCRIPT_DIR/lib/db.sh"
source "$SCRIPT_DIR/lib/fetch.sh"
source "$SCRIPT_DIR/lib/detect.sh"
source "$SCRIPT_DIR/lib/report.sh"

usage() {
    cat <<EOF
borg — AI commit adoption tracker
"Resistance is futile"

Usage:
  borg fetch  --org <org> [--since <date>] [--db <path>]
  borg report [--top <n>] [--db <path>]
  borg export [--csv <path>] [--db <path>]
  borg status [--db <path>]

Commands:
  fetch    Fetch commits from GitHub org (incremental, rate-limit aware)
  report   Show AI adoption report with rankings and trends
  export   Export database to CSV
  status   Show sync status

Options:
  --org    GitHub organization (required on first fetch, remembered after)
  --since  Floor date YYYY-MM-DD (required on first fetch, remembered after)
  --top    Number of entries in rankings (default: 10)
  --db     Database path (default: <script_dir>/data/tracker.db)
  --csv    CSV output path (default: stdout)
EOF
    exit 1
}

if [[ $# -eq 0 ]]; then
    usage
fi

COMMAND="$1"
shift

DB="$DEFAULT_DB"
ORG=""
SINCE=""
TOP=10
CSV=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --org)
            [[ $# -ge 2 ]] || { echo "Error: --org requires a value" >&2; exit 1; }
            ORG="$2"; shift 2 ;;
        --since)
            [[ $# -ge 2 ]] || { echo "Error: --since requires a value" >&2; exit 1; }
            SINCE="$2"; shift 2 ;;
        --top)
            [[ $# -ge 2 ]] || { echo "Error: --top requires a value" >&2; exit 1; }
            TOP="$2"; shift 2 ;;
        --db)
            [[ $# -ge 2 ]] || { echo "Error: --db requires a value" >&2; exit 1; }
            DB="$2"; shift 2 ;;
        --csv)
            [[ $# -ge 2 ]] || { echo "Error: --csv requires a value" >&2; exit 1; }
            CSV="$2"; shift 2 ;;
        *)
            echo "Unknown option: $1" >&2; usage ;;
    esac
done

# Validate --top is a positive integer
if ! [[ "$TOP" =~ ^[0-9]+$ ]] || [[ "$TOP" -eq 0 ]]; then
    echo "Error: --top must be a positive integer" >&2
    exit 1
fi

# Validate --since is YYYY-MM-DD if provided
if [[ -n "$SINCE" ]] && ! [[ "$SINCE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    echo "Error: --since must be in YYYY-MM-DD format" >&2
    exit 1
fi

# Initialize database
db_init "$DB"

# Resolve org and since from sync_meta if not provided
if [[ -z "$ORG" ]]; then
    ORG=$(db_get_meta "$DB" "org")
fi
if [[ -z "$SINCE" ]]; then
    SINCE=$(db_get_meta "$DB" "default_since")
fi

case "$COMMAND" in
    fetch)
        if [[ -z "$ORG" ]]; then
            echo "Error: --org required on first run" >&2
            exit 1
        fi
        if [[ -z "$SINCE" ]]; then
            echo "Error: --since required on first run (e.g. --since 2026-01-01)" >&2
            exit 1
        fi
        db_set_meta "$DB" "org" "$ORG"
        db_set_meta "$DB" "default_since" "$SINCE"
        fetch_commits "$DB" "$ORG" "$SINCE"
        detect_ai "$DB"
        ;;
    report)
        if [[ -z "$ORG" ]]; then
            echo "Error: no data yet. Run 'borg fetch' first." >&2
            exit 1
        fi
        report_show "$DB" "$ORG" "$SINCE" "$TOP"
        ;;
    export)
        if [[ -z "$CSV" ]]; then
            CSV="/dev/stdout"
        fi
        db_export_csv "$DB" "$CSV"
        ;;
    status)
        db_show_status "$DB"
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        usage
        ;;
esac
